#!/usr/bin/env python3
"""Reverse a string given on the command line."""

from __future__ import annotations

import logging
import sys

logger = logging.getLogger(__name__)


def reverse(text: str) -> str:
    """Return the characters of text in reverse order."""
    return text[::-1]


