# #1413: the video-gen gallery, behind a login, at :8043.
#
# Serves ~/bench-logs/videogen/gallery/ (built by scripts/videogen/gallery.py;
# batch.py rebuilds it after each clip). Every request needs a session except
# the login form. The server answers GET and HEAD for files, and refuses a
# file whose real path is outside ~/bench-logs/videogen/. It answers only a
# Host that is an IP literal, localhost, or a --host-name.
#
# It refuses to start without the credentials file
# (~/.config/local-llm/videogen-gallery/auth.yaml, mode 0600). Make it first:
#   uv run python scripts/videogen/gallery_serve.py set-password --user NAME
#
# The port is fixed. 8040 is H3, 8041 is vLLM-Omni, 8042 is dgx_server.py's
# ad-hoc clip viewer. tests/test_videogen_gallery_serve.py pins this file's
# --port to gallery_serve.DEFAULT_PORT.
#
# Install (as the operator's user, on the head; linger must be on):
#   uv sync      # the server needs PyYAML in ~/git/local-llm/.venv
#   cp systemd/local-llm-videogen-gallery.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now local-llm-videogen-gallery.service
[Unit]
Description=local-llm video-gen gallery (read-only, behind a login, :8043)
Documentation=https://github.com/evanwtf/local-llm/issues/1413

[Service]
Type=simple
WorkingDirectory=%h/git/local-llm
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# --no-sync: a service must not rewrite .venv; run `uv sync` on deploy instead.
# $GALLERY_HOST_ARGS is empty here: no host name and no LAN address go in
# this public repo. Set --host-name and --trusted-proxy in a drop-in
# (systemctl --user edit; see scripts/videogen/README.md). An unset variable
# expands to no argument at all.
ExecStart=%h/.local/bin/uv run --frozen --no-sync python scripts/videogen/gallery_serve.py --port 8043 $GALLERY_HOST_ARGS
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
# No ReadOnlyPaths: on the head (systemd 255, user manager) it was accepted
# and silently not applied, so it would only look like a guard. The server
# itself writes nothing: POST is only login and logout, which set a cookie.

[Install]
WantedBy=default.target
