          "temperature": false,
          "tool_call": true
        }
      },
      "name": "ds4 (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "local",
        "baseURL": "http://127.0.0.1:8000/v1",
        "chunkTimeout": 900000,
        "timeout": false
      }
    },
    "ds4anthropic": {
