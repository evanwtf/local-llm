{
  "$schema": "https://opencode.ai/config.json",
  "model": "mtplx/mtplx-qwen38-27b-optimized-speed",
  "permission": {
    "external_directory": {
      "*": "deny"
    }
  },
  "provider": {
    "ds4": {
      "models": {
        "deepseek-v4-flash": {
          "limit": {
            "context": 100000,
            "output": 100000
          },
          "name": "ds4 (local)",
          "reasoning": false,
          "temperature": false,
          "tool_call": true
        },
        "glm-5.3-flash": {
          "limit": {
            "context": 100000,
            "output": 100000
          },
          "name": "GLM-5.3-Flash (local, ds4)",
